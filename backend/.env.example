PORT=8080
DATABASE_URL=postgres://triplee_app:your-password@localhost:5432/triplee
JWT_SECRET=replace-with-a-long-random-string
# Folder containing the HTML/JS/CSS (served by Express in dev; use Nginx in production)
FRONTEND_DIR=../Finance_Inventory
COOKIE_SECURE=false

# ---- Online shop: business details shown on the shop, the Help page and in customer emails ----
# Leave a line empty to hide it. Nothing here is secret: customers see it.
SHOP_PHONE=
SHOP_EMAIL=
SHOP_VIBER=
SHOP_MESSENGER=
SHOP_ADDRESS=
SHOP_HOURS=
DELIVERY_FEE=150
DELIVERY_AREAS=
DELIVERY_LEAD_TIME=
PICKUP_NOTE=
REFUND_WINDOW_DAYS=7
# Needed for the "View my orders" link in emails and for Xendit redirects, e.g. https://shop.yourdomain.com
APP_BASE_URL=
# Customer emails need ONE of these (see mailer.js): Gmail app password, or Mailgun
GMAIL_USER=
GMAIL_APP_PASSWORD=
